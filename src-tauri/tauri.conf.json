{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VeldNotes",
  "version": "0.1.2",
  "identifier": "com.veldnotes.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "enableGTKAppId": true,
    "windows": [
      {
        "title": "VeldNotes",
        "width": 960,
        "height": 640,
        "minWidth": 640,
        "minHeight": 420,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$HOME/**",
          "$DATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "files": {
          "/usr/share/applications/com.veldnotes.app.desktop": "desktop/com.veldnotes.app.desktop"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/applications/com.veldnotes.app.desktop": "desktop/com.veldnotes.app.desktop"
        }
      }
    }
  }
}